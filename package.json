{
  "name": "pr-auto-review",
  "version": "1.0.1",
  "description": "Automated pull request tool with ESLint checks, Jest tests, and GitHub API integration.",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js --ignore coverage/ --ignore temp_event.json --ignore .eslintcache --ignore node_modules/"
  },
  "keywords": [
    "github",
    "pull-request",
    "pr-review",
    "eslint",
    "jest",
    "automation",
    "ci-cd",
    "code-quality",
    "octokit"
  ],
  "author": "Thomas Lynn",
  "license": "TLN",
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "@typescript-eslint/parser": "^8.43.0",
    "eslint": "^9.35.0",
    "globals": "^16.3.0",
    "jest": "^30.1.3",
    "nodemon": "^3.1.11"
  },
  "dependencies": {
    "@octokit/rest": "^22.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^4.18.2"
  }
}
