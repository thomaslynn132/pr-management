{
  "name": "pr-auto-review",
  "version": "1.0.1",
  "description": "Automated pull request tool with ESLint checks, Jest tests, and GitHub API integration.",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "lint": "eslint . --ext .js,.mjs,.cjs",
    "test": "jest --runInBand",
    "start": "node index.js",
    "test:coverage": "jest --coverage --coverageReporters=json-summary",
    "generate-event": "node ./scripts/generate-event.js",
    "pr-check": "npm run generate-event && node ./scripts/pr-check.js",
    "dev": "nodemon index.js --ignore coverage/ --ignore temp_event.json --ignore .eslintcache --ignore node_modules/"
  },
  "keywords": [
    "github",
    "pull-request",
    "pr-review",
    "eslint",
    "jest",
    "automation",
    "ci-cd",
    "code-quality",
    "octokit"
  ],
  "author": "Thomas Lynn",
  "license": "TLN",
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "@typescript-eslint/parser": "^8.43.0",
    "eslint": "^9.35.0",
    "globals": "^16.3.0",
    "nodemon": "^3.1.11",
    "jest": "^30.1.3"
  },
  "dependencies": {
    "@octokit/rest": "^22.0.0",
    "cors": "^2.8.5",
    "express": "^4.18.2"
  }
}
